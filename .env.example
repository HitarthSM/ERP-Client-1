# Pramukh Digital client — root env (copy to .env; never commit .env)
# Releases publish to: https://github.com/HitarthSM/ERP-Client

# Electron + UI + installer display name (change this once — applies everywhere)
APP_NAME=Pramukh Digital

# Required for: npm run publish-release
#
# Fine-grained PAT (recommended):
#   Resource owner: your user (HitarthSM)
#   Repository: Only HitarthSM/ERP-Client
#   Permissions → Repository → Contents: Read and write   ← MUST be Write (Read-only = 403)
#   Metadata: Read
#
# Classic PAT:
#   Scope: repo
#
# Error "Resource not accessible by personal access token" = missing Contents: Write
GITHUB_DEPLOY_KEY=ghp_or_github_pat_here

# Optional for update checks (repo is public). Contents: Read is enough.
ERP_CLIENT_APP_UPDATE_KEY=
